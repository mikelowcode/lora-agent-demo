# LOCALIST backend environment configuration
# Copy this file to .env and fill in your values.
# All variables are optional — defaults are shown.

# ── Runtime backend selection ─────────────────────────────────────────────
# Which BaseRuntimeClient implementation to construct at startup: foundry,
# omlx, or ollama (see runtime_factory.py's _REGISTRY). Swapping this is the
# only change needed to move between backends.
LOCALIST_RUNTIME_BACKEND=foundry

# ── Foundry model IDs ──────────────────────────────────────────────────────
# Must match the IDs returned by GET /v1/models on your Foundry instance.
LOCALIST_CHAT_MODEL=Phi-4-mini-instruct-generic-gpu:5
LOCALIST_EMBEDDING_MODEL=text-embedding-3-small

# ── Foundry network ────────────────────────────────────────────────────────
# Leave blank to auto-resolve from `foundry service status` at startup.
LOCALIST_FOUNDRY_URL=
LOCALIST_STREAM_TIMEOUT=60.0
LOCALIST_REQUEST_TIMEOUT=30.0

# ── Local embedding engine (EmbeddingGemma via MLX) ────────────────────────
# Loads the standalone MLX-LM EmbeddingEngine at startup for local corpus/
# episodic-memory embeddings — independent of LOCALIST_RUNTIME_BACKEND above.
# Apple Silicon only (a no-op elsewhere regardless of this value), and
# requires the `localist[mlx]` extra (see backend/pyproject.toml). First run
# downloads mlx-community/embeddinggemma-300m-4bit (~400MB) from Hugging
# Face — one-time, needs internet access. Ignored when LOCALIST_EMBEDDING_
# MODEL above is set and found by the active runtime backend, which is used
# instead. Default false — opt-in, not a silent first-run download. Without
# it, MemoryManager runs in keyword-only mode (still fully functional, just
# not semantic). start_localist.sh prompts once, interactively, on first run
# if this is unset and the [mlx] extra looks installed; set it explicitly
# here to skip that prompt.
LOCALIST_EMBEDDING_ENGINE_ENABLED=false

# ── Corpus paths ───────────────────────────────────────────────────────────
# Absolute paths.  Leave blank to use <backend>/wiki, <backend>/raw, etc.
LOCALIST_WIKI_DIR=
LOCALIST_RAW_DIR=
LOCALIST_SCHEMA_PATH=
LOCALIST_TEMPLATES_DIR=

# ── Agent behaviour ────────────────────────────────────────────────────────
# Set to true to have WikiAgent write wiki pages to disk immediately.
# When false (default), proposed changes are returned for review.
LOCALIST_AUTO_APPLY=false

# ── Episodic write-approval gate ──────────────────────────────────────────
# When true, model_extracted (implicit) episodes are staged as "pending"
# instead of going live immediately — approve/reject via
# POST /memory/episodes/{id}/approve|reject. Explicit "remember that..."
# episodes are never gated. Default false (unchanged behaviour).
LOCALIST_EPISODIC_WRITE_APPROVAL=false

# ── Research loop ──────────────────────────────────────────────────────────
# Upgrade web_search -> the research loop (search/evaluate/fetch/reformulate,
# see mcp_tool_dispatcher.py._run_research_loop) when the instruction's
# cosine similarity to the research_intent template group clears
# _RESEARCH_INTENT_THRESHOLD (planner.py). Off by default.
LOCALIST_RESEARCH_LOOP_ENABLED=false

# ── MCP server (localist-mcp, port 8003) ──────────────────────────────────
# Base URL the backend's MCPToolDispatcher connects to (/sse is appended
# automatically). Only needs to change if localist-mcp runs on a different
# host/port than the default started by start_localist.sh.
LOCALIST_MCP_URL=http://localhost:8003
# Sandbox root for file_op tools (read_file/write_file/append_file), read by
# localist-mcp itself, not the main backend process. Leave blank to default
# to backend/ (parent of the mcp_server/ package) — file_op reads/writes are
# further sandboxed under a generated_files/ subdirectory of this root.
LOCALIST_MCP_PROJECT_ROOT=
# Sandbox root for the ocr_extract tool's temp uploaded images/PDFs, read by
# localist-mcp itself. Leave blank to default to backend/ (parent of the
# mcp_server/ package), same convention as LOCALIST_MCP_PROJECT_ROOT above —
# OCR uploads are further sandboxed under a chat_uploads/ subdirectory of
# this root, kept separate from file_op's generated_files/ since this holds
# ephemeral user-uploaded input, not agent-authored output.
LOCALIST_MCP_UPLOAD_ROOT=
# Page cap for ocr_extract's rasterize+OCR fallback path (scanned PDFs
# only — a PDF with a real text layer is read directly regardless of page
# count). Bounds per-upload OCR latency. Default 20 if unset/invalid.
LOCALIST_OCR_MAX_PDF_PAGES=20
# On non-Apple-Silicon platforms, ocr_extract's image OCR path (not PDFs)
# falls back to a local Ollama vision-capable chat model instead of Apple's
# Vision framework. Set to a vision-capable model you've pulled locally,
# e.g. "llava" or "qwen2.5vl" — no default assumed, image OCR fails with a
# clear error on such a platform if this is unset. Ignored entirely on
# Apple Silicon, where Vision framework is always used instead.
LOCALIST_OLLAMA_VISION_MODEL=
# Local Ollama daemon base URL for the model above. Same variable
# name/meaning as backend/main.py's own Settings.ollama_url (used for
# LOCALIST_RUNTIME_BACKEND=ollama chat/embed) — read independently here
# since localist-mcp is a separate process. Leave blank to default to
# http://localhost:11434.
LOCALIST_OLLAMA_URL=

# ── External APIs ──────────────────────────────────────────────────────────
# web_search (localist-mcp) uses exactly one provider, chosen here.
# SEARCH_PROVIDER=langsearch (default) or brave.
SEARCH_PROVIDER=langsearch
LANGSEARCH_API_KEY=
BRAVE_API_KEY=
# WEB_SEARCH_PROVIDER — a second, separate provider switch layered on top
# of the web_search tool (mcp_tool_dispatcher.py), not to be confused with
# SEARCH_PROVIDER above (that one picks langsearch vs. brave *inside* the
# web_search MCP tool on localist-mcp itself). This one decides whether
# Ollama Cloud gets involved underneath that tool as a second provider.
# Read fresh on every call by _execute_web_search_query() — the single
# per-query call point also reused by news_search's Brave-fallback tier
# and the research loop, so switching this changes behavior in both of
# those code paths too, not just plain web searches.
# WEB_SEARCH_PROVIDER=brave   # default -- existing behavior, Ollama used only as a fallback when Brave returns nothing
# WEB_SEARCH_PROVIDER=ollama  # Ollama Cloud is the only search provider; Brave is never called (use this if you don't have a Brave API key)
WEB_SEARCH_PROVIDER=brave
# Required for WEB_SEARCH_PROVIDER=ollama (either as primary, or as the
# fallback tier under the default "brave" setting). Bearer token for
# Ollama Cloud's web search API (https://ollama.com/api/web_search),
# obtained from an ollama.com account — NOT reused from Ollama Cloud
# chat/embed inference (LOCALIST_RUNTIME_BACKEND=ollama above), which
# authenticates via the local Ollama daemon's own signed-in session and
# never sends an API key over HTTP, so there's nothing to reuse here.
OLLAMA_API_KEY=
# news_search (localist-mcp) — NewsAPI.org, first-tier provider for
# news-shaped queries, falling back to web_search (above) on a miss.
# Free Developer tier only: 100 req/day, 24h publish delay, last-month
# article window, explicitly NOT licensed for production/internal-
# production use per NewsAPI's terms. Acceptable here because Localist runs
# single-user on localhost and never leaves it — a paid tier is required
# the moment this code is ever deployed off a single local machine.
NEWSAPI_API_KEY=
# GitHub integration — read by two consumers:
#  - mcp_server/github.py (github_search/github_read tools): optional, used
#    opportunistically if present. Rate limits differ by endpoint:
#    github_read (core REST bucket) is 60 req/hr unauthenticated vs
#    5000 req/hr authenticated; github_search (Search API's separate,
#    stricter bucket) is 10 req/min unauthenticated vs 30 req/min
#    authenticated.
#  - backend/github_watch.py (Previews panel watch feed): required — reads
#    GET /user/subscriptions, which needs an authenticated identity.
# Use a classic PAT with no scopes selected (sufficient for all of the
# above — public data only, read-only, nothing is ever written back to
# GitHub). A fine-grained PAT will NOT work for the watch feed: as of this
# writing there is no fine-grained account permission covering
# GET /user/subscriptions, so it 403s regardless of what's granted.
GITHUB_TOKEN=

# ── Logging ────────────────────────────────────────────────────────────────
LOCALIST_LOG_LEVEL=INFO
